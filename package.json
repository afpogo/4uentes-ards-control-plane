    "jira:mcp:metadata": "node scripts/jira-mcp/read-metadata.js",
    "jira:mcp:duplicates": "node scripts/jira-mcp/search-duplicates.js",
    "jira:mcp:reconcile": "node scripts/jira-mcp/reconcile-existing-issues.js",
    "jira:mcp:status-observe": "node scripts/jira-mcp/observe-status.js",
    "jira:mcp:status-proposals": "node scripts/jira-mcp/generate-status-proposals.js",
    "jira:mcp:sync-health": "node scripts/jira-mcp/generate-sync-health.js",
