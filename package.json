    "jira:mcp:sync-machine": "node scripts/jira-mcp/sync-machine-runner.js",
    "jira:mcp:doctor": "node scripts/jira-mcp/doctor.js",
    "jira:mcp:create": "node scripts/jira-mcp/create-issues.js",
    "jira:writer:apply": "node scripts/jira-writer/apply-correction-plan.js",
    "plan:change": "node scripts/plan-change.js"
